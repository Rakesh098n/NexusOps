# NexusOps Environment Variables
# ================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Get your free Gemini API key from: https://aistudio.google.com/app/apikey
# The key looks like: AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_API_KEY=your_gemini_api_key_here

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Power Automate HTTP trigger URL (leave blank to run in demo/simulation mode)
# Create a "When an HTTP request is received" flow in Power Automate and paste the URL here
POWER_AUTOMATE_WEBHOOK_URL=
