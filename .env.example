# Copy to .env for local use. Never commit .env or production secrets.

# Groq-powered multi-agent analysis. Leave the key blank for local analytics.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# The demo mode seeds four sample role accounts. Disable it for deployment.
NEXUSOPS_DEMO_MODE=true
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Used only to bootstrap the first admin when NEXUSOPS_DEMO_MODE=false.
NEXUSOPS_ADMIN_USERNAME=
NEXUSOPS_ADMIN_PASSWORD=

# Optional Power Automate HTTP trigger URL. Empty means no webhook is called.
POWER_AUTOMATE_WEBHOOK_URL=
